{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldpulse.local/schema/goldstandard-event-v1.json",
  "title": "WorldPulse Goldstandard-Ereignis (Version 1)",
  "description": "Ein handgeprüftes Ereignis: Quellen, Soll-Claims mit Belegspanne, Entitäten, optional Referenz-Dossier. Referenzen (source_id, entities, claim_ids) und Belegspannen prüft zusätzlich GoldLoader.validate().",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "category", "sources", "claims"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^gold-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 3 },
    "category": { "enum": ["konflikt", "politik", "protest", "erdbeben", "brand", "unwetter", "katastrophe", "wirtschaft", "lokal", "event", "sonstiges"] },
    "event_time": { "type": ["string", "null"], "format": "date-time" },
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "lat", "lon", "precision"],
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "precision": { "enum": ["LAND", "REGION", "STADT", "STRASSE", "PUNKT"] }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "publisher", "tier", "language", "text"],
        "properties": {
          "id": { "type": "string" },
          "publisher": { "type": "string" },
          "tier": { "enum": ["A", "B", "C"] },
          "url": { "type": ["string", "null"], "pattern": "^https://" },
          "published_at": { "type": ["string", "null"], "format": "date-time" },
          "language": { "type": "string", "pattern": "^[a-z]{2}$" },
          "translated_from": { "type": ["string", "null"], "pattern": "^[a-z]{2}$" },
          "echo_group": { "type": ["string", "null"] },
          "text": { "type": "string", "minLength": 10 }
        }
      }
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_id", "text", "speaker", "type", "span"],
        "properties": {
          "id": { "type": "string" },
          "source_id": { "type": "string" },
          "text": { "type": "string", "minLength": 3 },
          "speaker": { "type": "string" },
          "type": { "enum": ["FAKT", "BEHAUPTUNG", "ZITAT", "MEINUNG", "UNKLAR"] },
          "span": { "type": "string", "minLength": 3 },
          "entities": { "type": "array", "items": { "type": "string" } },
          "event_time": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "enum": ["PERSON", "ORGANISATION", "ORT", "SONSTIGES"] },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "wikidata_id": { "type": ["string", "null"], "pattern": "^Q[0-9]+$" }
        }
      }
    },
    "reference_dossier": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "claim_ids"],
        "properties": {
          "text": { "type": "string" },
          "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "notes": { "type": ["string", "null"] },
    "checked_by": { "type": ["string", "null"] },
    "checked_at": { "type": ["string", "null"], "format": "date" }
  }
}
